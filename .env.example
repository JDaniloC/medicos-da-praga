# Provedor de LLM para a narração: "gemini" (padrão) ou "ollama". Apenas no servidor.
LLM_PROVIDER=gemini

# Google Gemini — usado quando LLM_PROVIDER=gemini. https://aistudio.google.com/apikey
# Sem chave (ou se o provedor falhar), a narração cai em fallback (mostra o briefing).
# NUNCA comite a chave real. Usada só no servidor (rotas /api/*).
GEMINI_API_KEY=

# Ollama — usado quando LLM_PROVIDER=ollama (servidor local ou hospedado).
# OLLAMA_MODEL é obrigatório nesse modo (ex.: llama3.1, qwen2.5).
# OLLAMA_API_KEY é opcional — só para endpoints autenticados/hospedados (enviado como Bearer).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_API_KEY=

# Supabase — fonte da verdade da história (servidor). NUNCA expor a service role ao navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 — base pública das imagens estáticas (CDN). Ex.: https://pub-xxxx.r2.dev
# Esta é a única var R2 exposta ao navegador (URL pública, tudo bem).
NEXT_PUBLIC_R2_BASE_URL=

# Cloudflare R2 — credenciais S3 para SUBIR as imagens (só no servidor/script "npm run upload:r2").
# Crie em: Cloudflare > R2 > Manage R2 API Tokens > Create (Object Read & Write). NUNCA comitar.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
