# Google Gemini — narração ao vivo (servidor). https://aistudio.google.com/apikey
# Sem ela, a narração cai em fallback (mostra o briefing). NUNCA comite a chave real.
GEMINI_API_KEY=

# Supabase — fonte da verdade da história (servidor). NUNCA expor a service role ao navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 — base pública das imagens estáticas (CDN). Ex.: https://pub-xxxx.r2.dev
NEXT_PUBLIC_R2_BASE_URL=
